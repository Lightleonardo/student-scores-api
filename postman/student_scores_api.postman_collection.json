{
  "info": {
    "_postman_id": "b7f1c2a4-9d3e-4a6b-8c1f-2e5a7d9b0c31",
    "name": "Student Scores API",
    "description": "Collection for the Student Scores API. Write requests (POST/PUT) use HTTP Basic Auth with username admin and password changeme123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": {
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "changeme123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create subject",
      "request": {
        "auth": {
          "type": "basic",
          "basic": {
            "username": "{{username}}",
            "password": "{{password}}"
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mathematics\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subjects/",
          "host": ["{{baseUrl}}"],
          "path": ["subjects", ""]
        },
        "description": "Create a subject. Requires auth. Returns 201."
      }
    },
    {
      "name": "List subjects",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subjects/",
          "host": ["{{baseUrl}}"],
          "path": ["subjects", ""]
        },
        "description": "List all subjects. No auth required. Returns 200."
      }
    },
    {
      "name": "Get subject by ID",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subjects/1",
          "host": ["{{baseUrl}}"],
          "path": ["subjects", "1"]
        },
        "description": "Get a single subject. No auth required. Returns 200 or 404."
      }
    },
    {
      "name": "Create assessment",
      "request": {
        "auth": {
          "type": "basic",
          "basic": {
            "username": "{{username}}",
            "password": "{{password}}"
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject_id\": 1,\n  \"name\": \"Midterm Exam\",\n  \"max_score\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessments/",
          "host": ["{{baseUrl}}"],
          "path": ["assessments", ""]
        },
        "description": "Create an assessment under an existing subject. Requires auth. Returns 201, or 404 if the subject does not exist."
      }
    },
    {
      "name": "List assessments",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assessments/",
          "host": ["{{baseUrl}}"],
          "path": ["assessments", ""]
        },
        "description": "List all assessments. No auth required. Returns 200."
      }
    },
    {
      "name": "Get assessment by ID",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assessments/1",
          "host": ["{{baseUrl}}"],
          "path": ["assessments", "1"]
        },
        "description": "Get a single assessment. No auth required. Returns 200 or 404."
      }
    },
    {
      "name": "Add score",
      "request": {
        "auth": {
          "type": "basic",
          "basic": {
            "username": "{{username}}",
            "password": "{{password}}"
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_name\": \"Ada Lovelace\",\n  \"assessment_id\": 1,\n  \"value\": 80\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/scores",
          "host": ["{{baseUrl}}"],
          "path": ["scores"]
        },
        "description": "Add a score for a student on an assessment. Requires auth. Returns 201, 404 if the assessment does not exist, or 400 if the value exceeds max_score."
      }
    },
    {
      "name": "Update score",
      "request": {
        "auth": {
          "type": "basic",
          "basic": {
            "username": "{{username}}",
            "password": "{{password}}"
          }
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 95\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/scores/1",
          "host": ["{{baseUrl}}"],
          "path": ["scores", "1"]
        },
        "description": "Update an existing score. Requires auth. Returns 200, 404 if the score does not exist, or 400 if the value exceeds max_score."
      }
    },
    {
      "name": "Get student results",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/Ada%20Lovelace/results",
          "host": ["{{baseUrl}}"],
          "path": ["students", "Ada Lovelace", "results"]
        },
        "description": "Get all scores for a student. No auth required. Returns 200 or 404 if the student has no results."
      }
    },
    {
      "name": "Get student average",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/students/Ada%20Lovelace/average",
          "host": ["{{baseUrl}}"],
          "path": ["students", "Ada Lovelace", "average"]
        },
        "description": "Get a student's average score. No auth required. Returns 200 or 404 if the student has no results."
      }
    }
  ]
}
